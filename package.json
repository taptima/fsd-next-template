{
    "name": "fsd-next-template",
    "version": "3.0.0",
    "description": "Taptima's Next.js Foundation powered by Feature-Sliced Design (FSD)",
    "license": "MIT",
    "author": {
        "name": "Taptima",
        "email": "hello@taptima.ru",
        "url": "https://taptima.com"
    },
    "scripts": {
        "dev": "next",
        "debug": "NODE_OPTIONS='--inspect' next dev",
        "typecheck": "tsc --noEmit",
        "build": "next build",
        "analyze": "NEXT_ANALYZE=true next build",
        "start": "next start",
        "format": "prettier --write --check",
        "format-all": "pnpm run format \"src/**/*.{js,jsx,ts,tsx,json,css,scss}\"",
        "lint-js": "eslint --fix",
        "lint-js-all": "pnpm run lint-js \"src/**/*.{js,jsx,ts,tsx}\"",
        "lint-styles": "stylelint --fix --config .stylelintrc.json",
        "lint-styles-all": "pnpm run lint-styles \"src/**/*.{css,scss}\"",
        "lint-deadcode": "ts-prune --skip '@types' --ignore '.next|middleware|config|app|shared/lib/mock|shared/types/graphql|.d.ts|.stories.tsx'",
        "lint": "pnpm run lint-js-all && pnpm run lint-styles-all && pnpm format-all --check",
        "graphql:build": "graphql-codegen --config codegen.yml --verbose",
        "svg:optimize": "svgo --exclude \".*\\.raw\\.svg\"",
        "svg:optimize-all": "pnpm run svg:optimize -f src/shared/assets/icons",
        "storybook:dev": "storybook dev -p 6006 -c ./config/storybook --no-open",
        "storybook:build": "storybook build -c ./config/storybook",
        "utils:sync-colors": "node scripts/sync-colors.js",
        "verify:release-version": "node scripts/verify-release-version.cjs",
        "test:unit": "jest --config config/jest/jest.config.ts",
        "prepare": "husky"
    },
    "browserslist": [
        "last 1 Chrome major versions",
        "last 2 Firefox major versions",
        "last 2 Safari major versions",
        "last 2 Edge major versions",
        "last 3 Android major versions",
        "last 3 ChromeAndroid major versions",
        "last 2 iOS major versions"
    ],
    "engines": {
        "node": "^24.19.0",
        "pnpm": "^12.3.4"
    },
    "packageManager": "pnpm@12.3.4",
    "dependencies": {
        "@hookform/resolvers": "^5.9.1",
        "async-mutex": "^0.5.0",
        "axios": "^1.20.0",
        "clsx": "^2.1.1",
        "graphql": "^17.0.2",
        "next": "16.3.5",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hook-form": "^7.88.0",
        "react-hot-toast": "^2.6.1",
        "react-imask": "^7.6.1",
        "sharp": "^0.35.4",
        "swr": "^2.5.1",
        "typescript": "^6.0.3",
        "yup": "^1.7.1",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.3",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^9.39.5",
        "@graphql-codegen/cli": "^7.4.2",
        "@graphql-codegen/typescript": "^6.1.0",
        "@graphql-codegen/typescript-operations": "^6.1.7",
        "@next/bundle-analyzer": "^16.3.5",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/addon-links": "^10.6.0",
        "@storybook/nextjs": "^10.6.0",
        "@storybook/testing-library": "^0.2.2",
        "@svgr/webpack": "^8.1.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.70.1",
        "@typescript-eslint/parser": "^8.70.1",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-no-relative-import-paths": "^1.7.3",
        "eslint-plugin-perfectionist": "^5.11.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-storybook": "^10.6.0",
        "globals": "^17.12.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "lint-staged": "^17.5.1",
        "loader-utils": "^3.3.1",
        "prettier": "^3.9.8",
        "regenerator-runtime": "^0.14.1",
        "sass": "^1.104.1",
        "storybook": "^10.6.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-order": "^8.1.1",
        "svgo": "^4.1.0",
        "ts-prune": "^0.10.3",
        "typescript-eslint": "^8.70.1",
        "webpack": "^5.111.1"
    }
}
